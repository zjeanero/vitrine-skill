{
  "description": "Boas-vindas da Vitrine na primeira sessão depois da instalação",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/boas-vindas.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
